{"nodes": [{"id": "_github_workflows_dependabot_auto_merge_dependabot_auto_merge_workflow", "label": "Dependabot Auto-Merge Workflow", "file_type": "code", "source_file": ".github/workflows/dependabot-auto-merge.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses pull_request_target because Dependabot pull_request events get a read-only token; never checks out PR code so nothing to hijack. Enables native auto-merge so merge waits for all required checks."}, {"id": "_github_workflows_dependabot_auto_merge_compatibility_score_gate", "label": "Compatibility Score Gate (>80% or no score)", "file_type": "rationale", "source_file": ".github/workflows/dependabot-auto-merge.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Score 0 treated as 'no score' and non-blocking since compatibility scores are effectively npm/pip-only; requiring one would block Go, Docker and Actions updates forever."}, {"id": "_github_workflows_dependabot_auto_merge_dependabot_compat_pat", "label": "DEPENDABOT_COMPAT_PAT secret", "file_type": "concept", "source_file": ".github/workflows/dependabot-auto-merge.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fetch-metadata rejects the default GITHUB_TOKEN for compat-lookup."}, {"id": "_github_workflows_dependabot_auto_merge_bot_self_approval", "label": "Bot PR Approval (github-actions[bot])", "file_type": "rationale", "source_file": ".github/workflows/dependabot-auto-merge.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Satisfies required-approval branch protection; works because approver and author identities differ. CODEOWNERS requirements still block for a human, as intended fallback."}], "edges": [{"source": "_github_workflows_dependabot_auto_merge_dependa